# Root .gitignore for FlameCounsel

# Build outputs (Backend & Frontend)
**/dist/
**/dist-ssr/
**/build/
**/out/
*.tsbuildinfo
.vite/

# Dependencies
**/node_modules/

# Environment files
.env
.env.*
!.env.example
*.local

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
